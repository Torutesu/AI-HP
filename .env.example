# Canonical site origin for metadata / sitemap / llms.txt
NEXT_PUBLIC_SITE_URL=https://ai-hp.pages.dev

# Recommended free analytics stack:
# 1) Google Tag Manager container ID (preferred; place GA4 / Clarity tags inside GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 2) GA4 measurement ID (use only if GTM is not used yet)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# 3) Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# 4) Cloudflare Web Analytics token
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SEO verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recruiting review inbox
RECRUIT_REVIEW_EMAIL=hr@example.com
