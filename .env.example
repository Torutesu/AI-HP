# Cloudflare Pages Function secrets.
# Set these in the Pages dashboard → Settings → Environment variables,
# and in web/.dev.vars for local `wrangler pages dev`.

# Team notification — a Slack OR Discord incoming webhook URL (auto-detected).
# Slack:   https://api.slack.com/messaging/webhooks
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Auto-reply (自動返信) to the submitter via Resend — optional.
# If unset, the form still works (team notification only); no reply is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
AUTOREPLY_FROM_EMAIL=noreply@your-domain.com

# Link to the service-guide PDF, included in the download auto-reply — optional.
DOC_DOWNLOAD_URL=https://your-domain.com/docs/service-guide.pdf
