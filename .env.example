# Cloudflare Pages Function secrets.
# Set these in the Pages dashboard → Settings → Environment variables,
# and in web/.dev.vars for local `wrangler pages dev`.

# Team notification — a Slack OR Discord incoming webhook URL (auto-detected).
# Slack:   https://api.slack.com/messaging/webhooks
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Auto-reply (自動返信) to the submitter via Resend — optional.
# If unset, the form still works (team notification only); no reply is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
AUTOREPLY_FROM_EMAIL=noreply@your-domain.com

# Link to the service-guide PDF, included in the download auto-reply — optional.
DOC_DOWNLOAD_URL=https://your-domain.com/docs/service-guide.pdf

# --- Lead store (Phase 1) ---------------------------------------------------
# Submissions are saved to Cloudflare D1 (env.DB binding — set in the dashboard
# or wrangler.toml, not here) and appended to a private Google Sheet.
#
# Google Sheets sync (optional; if unset, only D1 + notifications run):
#   1) Create a spreadsheet; name the tab "Leads" (or set SHEETS_TAB).
#   2) Create a Google Cloud service account + JSON key; enable the Sheets API.
#   3) Share the spreadsheet with the service account's email as *Editor* only.
#      Do NOT enable "anyone with the link". Keep the account on 2FA.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
SHEETS_TAB=Leads

# --- Admin dashboard (Phase 2) ----------------------------------------------
# /admin と /api/admin/* を Cloudflare Access（Zero Trust・無料50人まで）で保護。
# Access が付与する JWT を Function 側でも検証します（多重防御）。
# Zero Trust ダッシュボード → Access → Applications で取得:
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=<Access アプリケーションの Application Audience (AUD) Tag>
