# Cloudflare Pages Function secrets (set these in the Pages dashboard →
# Settings → Environment variables, and in .dev.vars for local `wrangler pages dev`).

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where inquiry / download-request notifications are sent.
CONTACT_TO_EMAIL=sales@example.com

# Verified sender (must be a domain you've verified in Resend).
CONTACT_FROM_EMAIL=noreply@your-domain.com
